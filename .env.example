# Copy to .env.local and fill in values from the Supabase dashboard.
# Local development and Vercel previews use the DEV Supabase project;
# Vercel production uses the PROD project.

# Which environment these values belong to: development | production.
# Integration tests refuse to run unless this is "development".
APP_ENV=development

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret key. Bypasses RLS: used by integration tests (creating test
# users) and future background jobs, never by request handlers.
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase > Connect > Transaction pooler (port 6543). Copy the host exactly:
# it may be aws-0-... or aws-1-... depending on the project.
# Used by request handlers through withUserDb(), which drops to the
# "authenticated" role so RLS applies.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres

# Supabase > Connect > Session pooler or direct connection (port 5432).
# Used only by drizzle-kit migrations and test setup. Bypasses RLS.
DATABASE_ADMIN_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
